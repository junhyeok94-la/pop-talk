# --- Pop Talk FE 환경 변수 ---
# 이 파일을 복사해 .env.local 로 만들어 사용하세요. (.env.local 은 커밋되지 않습니다)

# 백엔드 오리진 (서버 사이드 프록시 대상 · 서버 컴포넌트 직접 호출 베이스)
API_ORIGIN=http://popcorn-private-alb-144239326-fdd5172f3bd6.kr.lb.naverncp.com:3200/

# 브라우저 fetch 베이스.
# "/be" → Next 리라이트 프록시 경유 (CORS·혼합콘텐츠 회피, 권장)
# 백엔드가 프론트 오리진을 CORS 허용하면 백엔드 오리진으로 직접 지정 가능.
NEXT_PUBLIC_API_BASE_URL=/be

# 인증·마이페이지·리뷰 WAS 오리진 (서버에서만 사용)
WAS_API_ORIGIN=http://popcorn-private-alb-144239326-fdd5172f3bd6.kr.lb.naverncp.com:3200/

# 자연어 영화 추천 채팅 백엔드 오리진 (Next Route Handler에서만 사용)
CHAT_API_ORIGIN=http://popcorn-private-alb-144239326-fdd5172f3bd6.kr.lb.naverncp.com:8000

# 추천받기 2 — 브라우저 직접 호출용 채팅 API 오리진 (public, 브라우저 노출)
NEXT_PUBLIC_CHAT_API_ORIGIN=http://popcorn-private-alb-144239326-fdd5172f3bd6.kr.lb.naverncp.com:8000
