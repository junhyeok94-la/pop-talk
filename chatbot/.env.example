APP_ENV=local
DATABASE_URL=postgresql+asyncpg://movie_app:movie_app_password@127.0.0.1:5432/movie_community
# 개발 서버는 dev, 운영 서버는 prd로 설정합니다.
DATABASE_SCHEMA=dev
CORS_ORIGINS=*
JWT_SECRET=

# CLOVA Studio에서 발급한 값을 입력합니다. 실제 키는 저장소에 커밋하지 마세요.
CLOVA_STUDIO_HOST=https://clovastudio.stream.ntruss.com
CLOVA_STUDIO_API_KEY=
CLOVA_STUDIO_REQUEST_ID=
CLOVA_STUDIO_ROUTER_ID=rdtll2wj
CLOVA_STUDIO_ROUTER_VERSION=14
CLOVA_STUDIO_CHAT_MODEL=HCX-007
# 비워 두면 CLOVA_STUDIO_CHAT_MODEL을 검수에도 사용합니다. 사용 가능한 별도 모델 또는
# 별도 배포 ID가 있다면 지정하여 생성-검수의 자기 검증 편향을 줄이세요.
CLOVA_STUDIO_REVIEW_MODEL=
CLOVA_STUDIO_EMBEDDING_PATH=/v1/api-tools/embedding/v2

# YouTube Data API v3 키입니다. 실제 키는 저장소에 커밋하지 마세요.
YOUTUBE_API_HOST=https://www.googleapis.com/youtube/v3
YOUTUBE_API_KEY=
YOUTUBE_REVIEW_DEFAULT_LIMIT=5

# true이면 외부 LLM 호출 없이 규칙 기반 응답으로 API 흐름을 테스트합니다.
CHAT_MOCK_MODE=true

# LLM 검수 통과 점수와 최초 초안 이후 허용할 최대 재시도 횟수입니다.
CHAT_REVIEW_PASS_SCORE=85
CHAT_REVIEW_MAX_RETRIES=2
CATALOG_RELEASE_YEAR_FROM=2020
CATALOG_RELEASE_YEAR_TO=2026

# Router가 Intent를 직접 나누게 하려면 CLOVA 콘솔에서 다음처럼 별도 도메인을 구성합니다.
# 예: 영화 정보, 영화 평점, 영화 리뷰, 영화 평점 및 리뷰
# 하나의 일반 도메인만 반환되면 애플리케이션의 규칙 기반 분류가 보완합니다.
